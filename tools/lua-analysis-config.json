      ".git",
      ".github",
      ".vscode",
      "test",
      "tools",
      "release",
      "node_modules"
    ],
    "diagnostics.globals": [
      "lib",
      "cache",
      "MySQL",
      "locale"
    ],
    "diagnostics.libraryFiles": "Disable"
  }
}
